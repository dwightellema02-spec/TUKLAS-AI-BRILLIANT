# Copy to .env (never commit it) and fill in. Used by docker-compose.yml. Check any setup with: npm run check:env
POSTGRES_PASSWORD=change-me-to-a-long-random-password
AUTH_SECRET=run_openssl_rand_-hex_32_and_paste_it_here
APP_URL=https://tuklas.your-school.edu.ph
# local = the built-in rule-based tutor; gemini = the external model (needs GEMINI_API_KEY)
AI_PROVIDER=local
GEMINI_API_KEY=
# First administrator: only used on the first start (never overwrites an account). Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Shown to students in the privacy notice. Set both before real students sign in.
SCHOOL_NAME=
PRIVACY_CONTACT_EMAIL=
# true = the AI tutor stays closed to a student until a teacher records the guardian's consent (docs/PRIVACY.md)
REQUIRE_GUARDIAN_CONSENT=false
