{
  "name": "tuklas-ai",
  "description": "Interactive and adaptive mathematics learning platform aligned with MATATAG curriculum.",
  "private": true,
  "version": "0.42.0-pilot",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:phase22": "AI_PROVIDER=local tsx scripts/test-phase22-documents.ts",
    "test:phase22:pg": "tsx scripts/test-phase22-prisma.ts",
    "test:phase23": "AI_PROVIDER=local tsx scripts/test-phase23-conversation.ts",
    "test:phase23:pg": "tsx scripts/test-phase23-prisma.ts",
    "eval:tutor": "tsx scripts/eval-tutor-conversations.ts",
    "test:phase24": "AI_PROVIDER=local tsx scripts/test-phase24-taglish-kinds.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backup": "sh scripts/backup-db.sh",
    "db:restore": "sh scripts/restore-db.sh",
    "check:env": "tsx scripts/check-env.ts",
    "retention": "tsx scripts/retention.ts",
    "test:phase43": "AI_PROVIDER=local tsx scripts/test-phase43-privacy.ts && AI_PROVIDER=local tsx scripts/test-phase43-prompts.ts",
    "test:phase44": "AI_PROVIDER=local tsx scripts/test-phase44-hardening.ts && tsx scripts/test-phase44-mistakes.ts",
    "test:phase44:pg": "tsx scripts/test-phase44-prisma.ts",
    "test:phase43:pg": "tsx scripts/test-phase43-prisma.ts",
    "start:production": "sh scripts/start-production.sh",
    "test:phase42": "tsx scripts/test-phase42-migrations.ts && tsx scripts/test-phase42-backup.ts && tsx scripts/test-phase42-ops.ts && AI_PROVIDER=local tsx scripts/test-phase42-ratelimit.ts",
    "test:phase42:load": "tsx scripts/test-phase42-load.ts",
    "simulate:container": "sh scripts/simulate-container.sh",
    "test:phase25": "AI_PROVIDER=local tsx scripts/test-phase25-classrooms.ts",
    "test:phase25:pg": "tsx scripts/test-phase25-prisma.ts",
    "test:phase26": "AI_PROVIDER=local tsx scripts/test-phase26-progress.ts",
    "test:phase26:pg": "tsx scripts/test-phase26-prisma.ts",
    "test:phase27": "AI_PROVIDER=local tsx scripts/test-phase27-grading.ts",
    "test:phase27:pg": "tsx scripts/test-phase27-prisma.ts",
    "test:phase28": "AI_PROVIDER=local tsx scripts/test-phase28-ownership.ts",
    "test:phase28:pg": "tsx scripts/test-phase28-prisma.ts",
    "test:phase29": "AI_PROVIDER=local tsx scripts/test-phase29-research.ts",
    "test:phase29:pg": "tsx scripts/test-phase29-prisma.ts",
    "test:phase30": "AI_PROVIDER=local tsx scripts/test-phase30-sessions.ts",
    "test:phase30:pg": "tsx scripts/test-phase30-prisma.ts",
    "test:phase31": "AI_PROVIDER=local tsx scripts/test-phase31-surface.ts",
    "test:phase31:pg": "tsx scripts/test-phase31-prisma.ts",
    "test:phase32": "AI_PROVIDER=local tsx scripts/test-phase32-voice.ts",
    "test:phase32:pg": "tsx scripts/test-phase32-prisma.ts",
    "test:phase33": "AI_PROVIDER=local tsx scripts/test-phase33-assessments.ts",
    "test:phase33:pg": "tsx scripts/test-phase33-prisma.ts",
    "test:phase34:journey": "node scripts/test-phase34-journey.mjs",
    "test:phase34:pg": "tsx scripts/test-phase34-prisma.ts",
    "test:phase35": "AI_PROVIDER=local tsx scripts/test-phase35-tutor-safety.ts",
    "test:phase36": "AI_PROVIDER=local tsx scripts/test-phase36-analytics.ts",
    "test:phase36:pg": "tsx scripts/test-phase36-prisma.ts",
    "test:phase37": "AI_PROVIDER=local tsx scripts/test-phase37-skills.ts",
    "test:phase38": "tsx scripts/test-phase38-curriculum.ts",
    "test:phase38:browser": "node scripts/test-phase38-browser.mjs",
    "test:phase41": "AI_PROVIDER=local tsx scripts/test-phase41-structure.ts && AI_PROVIDER=local tsx scripts/test-phase41-lesson-save.ts",
    "test:phase41:pg": "tsx scripts/test-phase41-prisma.ts",
    "test:phase40": "tsx scripts/test-phase40-coaching.ts",
    "test:phase40:pg": "tsx scripts/test-phase40-prisma.ts",
    "test:phase39": "AI_PROVIDER=local tsx scripts/test-phase39-unlocks.ts",
    "test:phase39:browser": "node scripts/test-phase39-browser.mjs",
    "test:phase39:pg": "tsx scripts/test-phase39-prisma.ts",
    "test:phase38:pg": "tsx scripts/test-phase38-prisma.ts",
    "test:phase37:pg": "tsx scripts/test-phase37-prisma.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "seed:curriculum": "SEED_CURRICULUM_ONLY=true tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "6.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "unpdf": "^1.8.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "6.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
