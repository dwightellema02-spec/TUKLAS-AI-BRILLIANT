# Tuklas AI Environment Configuration (Placeholders for future phases)
# Do not add real credentials to this file.

# AI Provider Configuration (Phase 7 - AI Tutor)
# Provider choices: "gemini" (default) or "local" (offline pedagogical engine)
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_API_KEY=""
GEMINI_API_KEY=""
AI_BASE_URL=""

# Host Configuration
APP_URL="http://localhost:3000"

# Database Configuration (Phase 2+)
# Connection string for PostgreSQL / Neon
DATABASE_URL="postgresql://user:password@localhost:5432/tuklas_ai"

# Authentication Configuration (Phase 2+)
AUTH_SECRET="placeholder_secret_min_32_characters_long"


# Phase 22: Document intelligence
# Directory for private uploaded originals (never served statically). Use a persistent volume in production.
DOCUMENT_STORAGE_DIR="./storage/documents"
# REQUIRED in production (server refuses to start otherwise): >= 32 random characters, e.g. `openssl rand -hex 32`
# AUTH_SECRET is already listed above; "placeholder_*" values are rejected when NODE_ENV=production.
